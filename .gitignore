# dependencies
node_modules/

# env files (real secrets never go in git)
.env
.env.local
.env*.local
.env.production
!.env*.example

# local deploy staging (contains built output + secrets, not for git)
deploy/
*.zip

# next.js
# The production build (.next) IS committed on purpose — Hostinger's
# Node.js app runner has no separate build step, so we ship a pre-built
# .next to avoid the app timing out while building on first boot.
.next/cache/
.next/dev/
.next/trace*
.next/diagnostics/
out/
next-env.d.ts
*.tsbuildinfo

# logs
*.log

# misc
.DS_Store
.vercel
