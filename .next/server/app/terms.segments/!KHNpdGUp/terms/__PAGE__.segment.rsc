2:["$","p",null,{"children":"Photographs and illustrations are intended to provide a general representation of destinations, hotels, activities and experiences and may not always represent the exact room, vehicle, facility or experience provided."}]
3:["$","h2",null,{"children":"3. Enquiries and Quotations"}]
4:["$","p",null,{"children":"Submitting an enquiry through our website, WhatsApp, social-media accounts, telephone, email or any other communication channel does not constitute a confirmed booking."}]
5:["$","p",null,{"children":"Any quotation provided by Voyager Vibe is subject to availability and may have a specified validity period."}]
6:["$","p",null,{"children":"A quotation may change before confirmation due to:"}]
7:["$","ul",null,{"children":[["$","li",null,{"children":"Changes in hotel availability"}],["$","li",null,{"children":"Transportation availability"}],["$","li",null,{"children":"Airline fares"}],["$","li",null,{"children":"Currency fluctuations"}],["$","li",null,{"children":"Government taxes or fees"}],["$","li",null,{"children":"Supplier price revisions"}],["$","li",null,{"children":"Changes requested by the traveller"}]]}]
8:["$","p",null,{"children":"The final price applicable to a booking will be communicated to the traveller before confirmation."}]
9:["$","h2",null,{"children":"4. Booking Confirmation"}]
a:["$","p",null,{"children":"A booking shall be considered confirmed only after:"}]
