c:["$","p",null,{"children":"A payment alone does not automatically guarantee a booking unless the booking has been confirmed by Voyager Vibe."}]
d:["$","h2",null,{"children":"5. Traveller Information"}]
e:["$","p",null,{"children":"Travellers are responsible for providing accurate and complete information, including where applicable:"}]
f:["$","ul",null,{"children":[["$","li",null,{"children":"Full name as per travel document"}],["$","li",null,{"children":"Date of birth"}],["$","li",null,{"children":"Passport details"}],["$","li",null,{"children":"Contact information"}],["$","li",null,{"children":"Emergency contact information"}],["$","li",null,{"children":"Visa information"}],["$","li",null,{"children":"Special requirements"}],["$","li",null,{"children":"Dietary requirements"}],["$","li",null,{"children":"Medical or mobility-related assistance requirements relevant to the trip"}]]}]
10:["$","p",null,{"children":"Voyager Vibe shall not be responsible for additional costs, denied boarding, visa issues, incorrect tickets or other consequences arising from incorrect or incomplete information supplied by the traveller."}]
11:["$","h2",null,{"children":"6. Passport, Visa and Travel Documents"}]
12:["$","p",null,{"children":"Travellers are solely responsible for ensuring that they possess valid travel documents required for their journey."}]
13:["$","p",null,{"children":"For international travel, travellers should independently verify:"}]
14:["$","ul",null,{"children":[["$","li",null,{"children":"Passport validity"}],["$","li",null,{"children":"Visa requirements"}],["$","li",null,{"children":"Immigration requirements"}],["$","li",null,{"children":"Transit visa requirements"}],["$","li",null,{"children":"Vaccination or health requirements where applicable"}],["$","li",null,{"children":"Entry and exit regulations"}],["$","li",null,{"children":"Destination-specific travel restrictions"}]]}]
15:["$","p",null,{"children":"Voyager Vibe may provide general travel guidance but does not guarantee visa approval, immigration clearance or entry into any country."}]
16:["$","p",null,{"children":"The final decision regarding visa issuance and immigration admission rests with the relevant government authority."}]
17:["$","h2",null,{"children":"7. Pricing"}]
18:["$","p",null,{"children":"Unless expressly stated otherwise, package prices may be subject to applicable taxes, government charges, service fees, airfare fluctuations, fuel surcharges, foreign-exchange fluctuations and other supplier-related charges."}]
19:["$","p",null,{"children":"Prices displayed on the website may be indicative and should not be treated as a guaranteed booking price unless specifically confirmed in writing."}]
1a:["$","p",null,{"children":"Any promotional offer shall be subject to its stated terms, validity period and availability."}]
1b:["$","p",null,{"children":"Voyager Vibe reserves the right to withdraw or modify promotional offers at any time, subject to applicable law and any booking already confirmed under the offer."}]
1c:["$","h2",null,{"children":"8. Payment"}]
1d:["$","p",null,{"children":"Payment schedules shall be communicated in the applicable quotation or booking confirmation."}]
1e:["$","p",null,{"children":"Depending upon the package, payment may include:"}]
