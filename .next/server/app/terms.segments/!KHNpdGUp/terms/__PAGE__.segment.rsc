20:["$","p",null,{"children":"Bookings may be cancelled or released if required payments are not received within the specified timelines."}]
21:["$","p",null,{"children":"Any applicable payment gateway, banking or transaction charges may be payable by the traveller where communicated in advance."}]
22:["$","h2",null,{"children":"9. Cancellation and Refunds"}]
23:["$","p",null,{"children":"Cancellation terms vary depending upon the package, destination, airline, hotel, transport provider, activity operator and other third-party suppliers."}]
24:["$","p",null,{"children":"The applicable cancellation and refund conditions will be communicated to the traveller at the time of booking or in the booking confirmation."}]
25:["$","p",null,{"children":"Certain bookings may be:"}]
